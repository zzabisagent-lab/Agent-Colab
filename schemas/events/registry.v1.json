{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/registry.v1.json",
  "title": "Agent-Colab Event registry v1",
  "version": 1,
  "aggregates": {
    "workspace": {
      "id_prefix": "ws-",
      "states": [
        "ACTIVE",
        "SUSPENDED"
      ]
    },
    "account": {
      "id_prefix": "acct-",
      "states": [
        "ACTIVE",
        "SUSPENDED",
        "DELETED"
      ]
    },
    "agent": {
      "id_prefix": "agent-",
      "states": [
        "pending",
        "active",
        "suspended",
        "revoked",
        "offline"
      ]
    },
    "role": {
      "id_prefix": "role-",
      "states": [
        "active",
        "retired"
      ]
    },
    "external_identity_link": {
      "id_prefix": "link-",
      "states": [
        "pending",
        "pending_admin",
        "active",
        "suspended",
        "revoked"
      ]
    },
    "channel": {
      "id_prefix": "chan-",
      "states": [
        "active",
        "archived",
        "deleted"
      ]
    },
    "bridge": {
      "id_prefix": "bridge-",
      "states": [
        "enabled",
        "disabled"
      ]
    },
    "task": {
      "id_prefix": "task-",
      "states": [
        "OPEN",
        "DELEGATED",
        "ACCEPTED",
        "RUNNING",
        "WAITING",
        "IMPLEMENTED",
        "VERIFYING",
        "VERIFIED",
        "COMPLETED",
        "CANCEL_REQUESTED",
        "CANCELLED"
      ]
    },
    "approval": {
      "id_prefix": "apr-",
      "states": [
        "REQUESTED",
        "PENDING",
        "APPROVED",
        "PARTIALLY_CONSUMED",
        "CONSUMED",
        "REJECTED",
        "CANCELLED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "artifact": {
      "id_prefix": "art-",
      "states": [
        "registered",
        "verified",
        "quarantined",
        "archived"
      ]
    },
    "document": {
      "id_prefix": "doc-",
      "states": [
        "DRAFT_PRE_VERIFICATION",
        "ATTEMPT_FINALIZED",
        "FINALIZED",
        "REVIEWED",
        "PUBLISHED"
      ]
    },
    "verification_run": {
      "id_prefix": "vr-",
      "states": [
        "PLANNED",
        "ASSIGNED",
        "RUNNING",
        "PASSED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "work_item": {
      "id_prefix": "wi-",
      "states": [
        "QUEUED",
        "DELIVERED",
        "ACKED",
        "IN_PROGRESS",
        "RESULT_RECEIVED",
        "REJECTED",
        "EXPIRED",
        "CANCELLED"
      ]
    },
    "budget": {
      "id_prefix": "bud-",
      "states": [
        "reserved",
        "settled",
        "exceeded"
      ]
    },
    "brainstorm": {
      "id_prefix": "bs-",
      "states": [
        "OPEN",
        "PAUSED",
        "SUMMARY",
        "DECISION",
        "CLOSED"
      ]
    },
    "decision": {
      "id_prefix": "dec-",
      "states": [
        "recorded",
        "taskified",
        "superseded"
      ]
    },
    "secret": {
      "id_prefix": "sec-",
      "states": [
        "registered",
        "rotated",
        "retired"
      ]
    },
    "secret_grant": {
      "id_prefix": "grant-",
      "states": [
        "active",
        "expired",
        "revoked"
      ]
    },
    "schedule": {
      "id_prefix": "sch-",
      "states": [
        "DRAFT",
        "ENABLED",
        "PAUSED",
        "DISABLED"
      ]
    },
    "schedule_run": {
      "id_prefix": "run-",
      "states": [
        "PENDING",
        "DUE",
        "CLAIMED",
        "TASK_CREATED",
        "RUNNING",
        "VERIFYING",
        "SUCCEEDED",
        "FAILED",
        "SKIPPED",
        "TIMED_OUT",
        "CANCEL_REQUESTED",
        "CANCELLED"
      ]
    },
    "setting": {
      "id_prefix": "set-",
      "states": [
        "active"
      ]
    },
    "break_glass": {
      "id_prefix": "bg-",
      "states": [
        "active",
        "ended"
      ]
    },
    "hard_delete": {
      "id_prefix": "hd-",
      "states": [
        "requested",
        "approved",
        "executed",
        "rejected"
      ]
    },
    "notification": {
      "id_prefix": "ntf-",
      "states": [
        "sent"
      ]
    },
    "task_criteria": {
      "id_prefix": "task-",
      "states": [
        "pinned",
        "revised"
      ]
    },
    "dependency": {
      "id_prefix": "dep-",
      "states": [
        "healthy",
        "degraded",
        "failed"
      ]
    }
  },
  "authority": {
    "approval_consumption": "approval_grants + approval_consumptions ledger (row lock in the append transaction)",
    "run_uniqueness": "schedule_runs UNIQUE(schedule_id, occurrence_key) + idempotency_key",
    "task_graph": "task_edges (append-only) + trigger cycle check",
    "assignments": "task_assignments append-only revisions",
    "permissions": "policy engine over committed RoleVersions; never tasks_projection/approvals_projection",
    "verification_independence": "verification_runs CHECK constraints + application alias/credential check",
    "idempotency": "events UNIQUE(workspace_id, actor_account_id, idempotency_scope, idempotency_key)"
  },
