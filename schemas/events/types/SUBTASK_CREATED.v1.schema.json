{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/types/SUBTASK_CREATED.v1.schema.json",
  "title": "SUBTASK_CREATED payload v1",
  "description": "Non-sensitive payload of SUBTASK_CREATED (task aggregate, Phase 1). Sensitive content goes to the encrypted envelope.",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": "string",
      "minLength": 1
    },
    "root_task_id": {
      "type": "string",
      "minLength": 1
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "channel_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "task_id",
    "parent_task_id",
    "root_task_id",
    "depth",
    "channel_id",
    "title",
    "domain",
    "risk"
  ],
  "additionalProperties": true
}
