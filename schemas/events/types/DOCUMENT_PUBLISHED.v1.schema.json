{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/types/DOCUMENT_PUBLISHED.v1.schema.json",
  "title": "DOCUMENT_PUBLISHED payload v1",
  "description": "Non-sensitive payload of DOCUMENT_PUBLISHED (document aggregate, Phase 6). Sensitive content goes to the encrypted envelope.",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "external_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "document_id",
    "version",
    "publisher",
    "external_ref"
  ],
  "additionalProperties": true
}
