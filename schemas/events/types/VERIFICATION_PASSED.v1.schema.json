{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/types/VERIFICATION_PASSED.v1.schema.json",
  "title": "VERIFICATION_PASSED payload v1",
  "description": "Non-sensitive payload of VERIFICATION_PASSED (verification_run aggregate, Phase 1). Sensitive content goes to the encrypted envelope.",
  "type": "object",
  "properties": {
    "verification_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "verification_id",
    "revision",
    "evidence_refs"
  ],
  "additionalProperties": true
}
