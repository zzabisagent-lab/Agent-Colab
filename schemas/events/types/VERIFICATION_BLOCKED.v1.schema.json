{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/types/VERIFICATION_BLOCKED.v1.schema.json",
  "title": "VERIFICATION_BLOCKED payload v1",
  "description": "Non-sensitive payload of VERIFICATION_BLOCKED (verification_run aggregate, Phase 1). Sensitive content goes to the encrypted envelope.",
  "type": "object",
  "properties": {
    "verification_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "verification_id",
    "revision",
    "reason_code"
  ],
  "additionalProperties": true
}
