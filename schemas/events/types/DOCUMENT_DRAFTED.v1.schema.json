{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/types/DOCUMENT_DRAFTED.v1.schema.json",
  "title": "DOCUMENT_DRAFTED payload v1",
  "description": "Non-sensitive payload of DOCUMENT_DRAFTED (document aggregate, Phase 1). Sensitive content goes to the encrypted envelope.",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "document_id",
    "source_type",
    "source_id",
    "version",
    "sha256"
  ],
  "additionalProperties": true
}
