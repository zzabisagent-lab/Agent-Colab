{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/types/AGENT_MARKED_OFFLINE.v1.schema.json",
  "title": "AGENT_MARKED_OFFLINE payload v1",
  "description": "Non-sensitive payload of AGENT_MARKED_OFFLINE (agent aggregate, Phase 3). Sensitive content goes to the encrypted envelope.",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "missed_heartbeats": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "agent_id",
    "missed_heartbeats"
  ],
  "additionalProperties": true
}
