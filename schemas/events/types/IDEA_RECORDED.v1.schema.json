{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/types/IDEA_RECORDED.v1.schema.json",
  "title": "IDEA_RECORDED payload v1",
  "description": "Non-sensitive payload of IDEA_RECORDED (brainstorm aggregate, Phase 6). Sensitive content goes to the encrypted envelope.",
  "type": "object",
  "properties": {
    "brainstorm_id": {
      "type": "string",
      "minLength": 1
    },
    "contribution_type": {
      "type": "string",
      "minLength": 1
    },
    "contributor_account_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_no": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "brainstorm_id",
    "contribution_type",
    "contributor_account_id",
    "turn_no"
  ],
  "additionalProperties": true
}
