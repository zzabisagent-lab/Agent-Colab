{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/types/IMPLEMENTATION_SUBMITTED.v1.schema.json",
  "title": "IMPLEMENTATION_SUBMITTED payload v1",
  "description": "Non-sensitive payload of IMPLEMENTATION_SUBMITTED (task aggregate, Phase 1). Sensitive content goes to the encrypted envelope.",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criteria_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "task_id",
    "evidence_refs",
    "criteria_revision"
  ],
  "additionalProperties": true
}
