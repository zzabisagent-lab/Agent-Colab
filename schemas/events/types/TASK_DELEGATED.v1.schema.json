{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/events/types/TASK_DELEGATED.v1.schema.json",
  "title": "TASK_DELEGATED payload v1",
  "description": "Non-sensitive payload of TASK_DELEGATED (task aggregate, Phase 1). Sensitive content goes to the encrypted envelope.",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "assignee_account_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_revision": {
      "type": "integer",
      "minimum": 0
    },
    "policy_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "task_id",
    "assignee_account_id",
    "assignment_revision",
    "policy_snapshot_hash"
  ],
  "additionalProperties": true
}
