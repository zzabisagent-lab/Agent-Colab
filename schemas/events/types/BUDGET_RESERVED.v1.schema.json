    },
    "scope_type": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "cost_units": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "reservation_id",
    "scope_type",
    "scope_id",
    "cost_units"
  ],
  "additionalProperties": true
}
