{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/channel/channel-config.v1.schema.json",
  "title": "Channel configuration v1 (spec §8.1)",
  "type": "object",
  "properties": {
    "channel_type": {"enum": ["work", "brainstorm", "approval", "ops", "custom"]},
    "template_id": {"type": ["string", "null"]},
    "policy": {"$ref": "channel-template.v1.schema.json"},
    "documentation_template": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"], "pattern": "^(ko|en)$"},
    "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "legal_hold": {"type": "boolean"}
  },
  "additionalProperties": false
}
