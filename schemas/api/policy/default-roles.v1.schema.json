{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/policy/default-roles.v1.schema.json",
  "title": "Agent-Colab default roles v1",
  "$defs": {
    "permission_pattern": {"type": "string", "pattern": "^([a-z]+\\.([a-z_]+|\\*))$"}
  },
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^role-[a-z-]+$"},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "display_name": {"type": "string", "minLength": 1},
          "principal_types": {"type": "array", "minItems": 1, "items": {"enum": ["human", "agent", "service"]}},
          "permissions": {"type": "array", "items": {"$ref": "#/$defs/permission_pattern"}},
          "deny": {"type": "array", "items": {"$ref": "#/$defs/permission_pattern"}},
          "constraints": {
            "type": "object",
            "properties": {
              "max_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
              "side_effects": {"enum": ["allow", "deny"]},
              "requires_human_approval": {"type": "array", "items": {"$ref": "#/$defs/permission_pattern"}},
              "domains": {"type": "array", "items": {"type": "string"}},
              "channels": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["max_risk", "side_effects", "requires_human_approval"],
            "additionalProperties": false
          },
          "notes": {"type": "string"}
        },
        "required": ["display_name", "principal_types", "permissions", "deny", "constraints"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "roles"],
  "additionalProperties": false
}
