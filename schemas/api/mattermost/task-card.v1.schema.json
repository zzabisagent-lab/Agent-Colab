{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/mattermost/task-card.v1.schema.json",
  "title": "Task card v1",
  "description": "Render model of the one root post per Task (development plan §7A.3). The card is edited in place on every transition; each transition also leaves one immutable thread reply.",
  "type": "object",
  "properties": {
    "task_id": {"type": "string", "pattern": "^task-"},
    "root_post_id": {"type": "string", "minLength": 1, "description": "Conversation.source_thread"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "status": {"type": "string", "enum": ["OPEN", "DELEGATED", "ACCEPTED", "RUNNING", "WAITING", "IMPLEMENTED", "VERIFYING", "VERIFIED", "COMPLETED", "CANCEL_REQUESTED", "CANCELLED"]},
    "risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "assignee": {"type": ["object", "null"], "properties": {"account_id": {"type": "string"}, "display_name": {"type": "string"}, "kind": {"type": "string", "enum": ["human", "agent"]}}, "required": ["account_id", "display_name", "kind"]},
    "verification_status": {"type": "string", "enum": ["NONE", "ASSIGNED", "RUNNING", "PASSED", "FAILED", "BLOCKED"]},
    "pending_approvals": {"type": "array", "items": {"type": "object", "properties": {"approval_id": {"type": "string"}, "action": {"type": "string"}, "risk": {"type": "string"}, "expires_at": {"type": "string"}, "decision_path": {"type": "string", "enum": ["button", "web"]}}, "required": ["approval_id", "action", "risk", "expires_at", "decision_path"]}},
    "latest_progress": {"type": ["object", "null"], "properties": {"summary": {"type": "string", "maxLength": 16000}, "at": {"type": "string"}, "coalesced_count": {"type": "integer", "minimum": 1}}, "required": ["summary", "at"]},
    "artifact_links": {"type": "array", "items": {"type": "object", "properties": {"artifact_id": {"type": "string"}, "label": {"type": "string"}, "url": {"type": "string"}}, "required": ["artifact_id", "label"]}},
    "document_links": {"type": "array", "items": {"type": "object", "properties": {"document_id": {"type": "string"}, "version": {"type": "integer"}, "status": {"type": "string"}, "url": {"type": "string"}}, "required": ["document_id", "version", "status"]}},
    "subtasks": {"type": "object", "properties": {"join_policy": {"type": "string", "enum": ["ALL", "ANY", "QUORUM"]}, "quorum": {"type": "integer", "minimum": 1}, "children": {"type": "array", "items": {"type": "object", "properties": {"task_id": {"type": "string"}, "status": {"type": "string"}, "verified": {"type": "boolean"}, "link_card_post_id": {"type": "string"}}, "required": ["task_id", "status", "verified"]}}, "satisfied": {"type": "boolean"}}, "required": ["join_policy", "children", "satisfied"]},
    "buttons": {"type": "array", "description": "Conveniences only; the server re-evaluates permission at callback time and processes duplicate clicks once by idempotency key.", "items": {"type": "object", "properties": {"action": {"type": "string", "enum": ["accept", "submit", "approve", "reject", "verify_pass", "verify_fail", "cancel"]}, "label_key": {"type": "string"}, "requires_permission": {"type": "string"}, "web_only": {"type": "boolean", "description": "HIGH+ approvals: the button only shows web guidance"}}, "required": ["action", "label_key", "requires_permission"]}},
    "card_version": {"type": "integer", "minimum": 1, "description": "incremented on every in-place edit"},
    "language": {"type": "string", "enum": ["ko", "en"]}
  },
  "required": ["task_id", "root_post_id", "title", "status", "risk", "assignee", "verification_status", "pending_approvals", "latest_progress", "artifact_links", "document_links", "buttons", "card_version", "language"],
  "additionalProperties": false
}
