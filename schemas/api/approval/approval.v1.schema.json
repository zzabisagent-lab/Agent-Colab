{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/approval/approval.v1.schema.json",
  "title": "Approval (grant view) v1",
  "description": "Approval bound to a subject, action, resource scope, executing principal, validity period and maximum use count (spec §8.4, §9.1). used_count is ledger-derived.",
  "type": "object",
  "required": ["approval_id", "subject_type", "subject_id", "action", "risk", "status", "requested_by", "valid_from", "expires_at", "quorum_required", "used_count"],
  "properties": {
    "approval_id": {"type": "string", "pattern": "^apr-[0-9a-f]{16}$"},
    "subject_type": {"type": "string", "enum": ["task", "schedule", "run", "action"]},
    "subject_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "resource_scope": {"type": "object"},
    "risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "status": {"type": "string", "enum": ["PENDING", "APPROVED", "PARTIALLY_CONSUMED", "CONSUMED", "REJECTED", "CANCELLED", "EXPIRED", "REVOKED"]},
    "requested_by": {"type": "string"},
    "implementing_agent_account_id": {"type": ["string", "null"]},
    "channel_id": {"type": ["string", "null"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "max_uses": {"type": ["integer", "null"], "minimum": 1},
    "quorum_required": {"type": "integer", "minimum": 0, "maximum": 2},
    "used_count": {"type": "integer", "minimum": 0},
    "decided_by": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
