{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/approval/approval-request.v1.schema.json",
  "title": "RequestApproval command v1",
  "type": "object",
  "required": ["subject_type", "subject_id", "action"],
  "properties": {
    "subject_type": {"type": "string", "enum": ["task", "schedule", "run", "action"]},
    "subject_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1, "description": "catalog action name, e.g. tool:task_delegate"},
    "risk": {"type": ["string", "null"], "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null], "description": "may only raise the catalog risk"},
    "resource_scope": {"type": "object"},
    "valid_for_seconds": {"type": ["integer", "null"], "minimum": 60},
    "max_uses": {"type": ["integer", "null"], "minimum": 1},
    "implementing_agent_account_uuid": {"type": ["string", "null"]},
    "channel_uuid": {"type": ["string", "null"]},
    "requires_human_approval": {"type": "boolean", "default": false}
  },
  "additionalProperties": false
}
