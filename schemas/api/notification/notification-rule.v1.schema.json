{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/notification/notification-rule.v1.schema.json",
  "title": "Notification rules file v1 (development plan §7G)",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "event_type", "recipient_selectors", "channels", "dedupe_window_seconds"],
        "additionalProperties": false,
        "properties": {
          "rule_id": {"type": "string", "pattern": "^ntf-[a-z0-9-]+$"},
          "event_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "recipient_selectors": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "enum": ["eligible_approvers", "verifier", "delegator", "channel_members", "ops_channel_members", "administrators", "agent_owner"]}
          },
          "channels": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "enum": ["mattermost:thread", "mattermost:dm", "mattermost:approval_channel", "mattermost:ops_channel", "mattermost:channel", "work_item", "smtp"]}
          },
          "dedupe_window_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
          "quiet_hours": {
            "type": ["object", "null"],
            "required": ["start", "end", "timezone"],
            "additionalProperties": false,
            "properties": {
              "start": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
              "end": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
              "timezone": {"type": "string", "minLength": 1}
            }
          },
          "reminders": {
            "type": "object",
            "required": ["at_ratio", "at_expiry"],
            "additionalProperties": false,
            "properties": {
              "at_ratio": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
              "at_expiry": {"type": "boolean"}
            }
          },
          "re_notify_after_seconds": {"type": "integer", "minimum": 1},
          "enabled": {"type": "boolean"},
          "version": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
