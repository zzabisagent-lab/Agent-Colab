{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/commands/verify.block.v1.schema.json",
  "title": "/colab verify block",
  "description": "Arguments of `/colab verify block`.",
  "x-permission": "verification.submit",
  "x-target": "task",
  "x-target-field": "task_id",
  "x-unlinked-allowed": false,
  "x-example": "/colab verify block task-123 --reason \"sandbox unreachable\"",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task-[A-Za-z0-9._-]{1,120}$",
      "description": "omitted inside a Task thread"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  },
  "required": [
    "reason"
  ],
  "additionalProperties": false
}
