{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/commands/verify.pass.v1.schema.json",
  "title": "/colab verify pass",
  "description": "Arguments of `/colab verify pass`.",
  "x-permission": "verification.submit",
  "x-target": "task",
  "x-target-field": "task_id",
  "x-unlinked-allowed": false,
  "x-example": "/colab verify pass task-123 --evidence art-90",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task-[A-Za-z0-9._-]{1,120}$",
      "description": "omitted inside a Task thread"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:/#@+-]{1,300}$"
      },
      "minItems": 1,
      "maxItems": 50
    },
    "comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  },
  "required": [
    "evidence"
  ],
  "additionalProperties": false
}
