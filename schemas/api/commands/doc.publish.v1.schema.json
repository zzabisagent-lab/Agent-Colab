{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/commands/doc.publish.v1.schema.json",
  "title": "/colab doc publish",
  "description": "Arguments of `/colab doc publish`.",
  "x-permission": "document.publish",
  "x-target": "subject",
  "x-target-field": "subject_id",
  "x-unlinked-allowed": false,
  "x-example": "/colab doc publish task-123 --publisher git",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "pattern": "^(task|bs)-[A-Za-z0-9._-]{1,120}$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  },
  "required": [],
  "additionalProperties": false
}
