{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/commands/verify.assign.v1.schema.json",
  "title": "/colab verify assign",
  "description": "Arguments of `/colab verify assign`.",
  "x-permission": "verification.assign",
  "x-target": "task",
  "x-target-field": "task_id",
  "x-unlinked-allowed": false,
  "x-example": "/colab verify assign task-123 --to @reviewer",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task-[A-Za-z0-9._-]{1,120}$",
      "description": "omitted inside a Task thread"
    },
    "to": {
      "type": "string",
      "pattern": "^(@[A-Za-z0-9._-]{1,64}|agent-[A-Za-z0-9._-]{1,120})$"
    }
  },
  "required": [],
  "additionalProperties": false
}
