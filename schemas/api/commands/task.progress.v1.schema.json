{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/commands/task.progress.v1.schema.json",
  "title": "/colab task progress",
  "description": "Arguments of `/colab task progress`.",
  "x-permission": "task.progress",
  "x-target": "task",
  "x-target-field": "task_id",
  "x-unlinked-allowed": false,
  "x-example": "/colab task progress task-123 \"half of the sections drafted\"",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task-[A-Za-z0-9._-]{1,120}$",
      "description": "omitted inside a Task thread"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000,
      "description": "progress note"
    }
  },
  "required": [
    "message"
  ],
  "additionalProperties": false
}
