{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/commands/brainstorm.start.v1.schema.json",
  "title": "/colab brainstorm start",
  "description": "Arguments of `/colab brainstorm start`.",
  "x-permission": "brainstorm.facilitate",
  "x-target": null,
  "x-target-field": null,
  "x-unlinked-allowed": false,
  "x-example": "/colab brainstorm start \"Q4 roadmap\" --participants @a,@b --turns-per-agent 5",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^@[A-Za-z0-9._-]{1,64}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "turns-per-agent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max-consecutive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "total-turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "budget": {
      "type": "integer",
      "minimum": 0
    },
    "time": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "topic",
    "participants"
  ],
  "additionalProperties": false
}
