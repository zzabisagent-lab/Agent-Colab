{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/api/artifact/artifact.v1.schema.json",
  "title": "Artifact v1",
  "type": "object",
  "required": ["artifact_id", "workspace_id", "creator_account_id", "storage_uri", "mime", "size", "sha256", "acl", "status", "source_event_id"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^art-[0-9a-f]{20}$"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "creator_account_id": {"type": "string", "format": "uuid"},
    "storage_uri": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://.+$"},
    "mime": {"type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"},
    "size": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acl": {"type": "object", "properties": {"readers": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "status": {"type": "string", "enum": ["registered", "verified", "quarantined", "archived"]},
    "source_event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{32}$"},
    "links": {"type": "array", "items": {"$ref": "artifact-link.v1.schema.json"}}
  },
  "additionalProperties": false
}
