{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colab.dev/schemas/documents/document-manifest.v1.schema.json",
  "title": "Canonical document manifest v1 (spec §14.1 provenance, development plan §10.4)",
  "type": "object",
  "required": [
    "document_id", "version", "status", "doc_type", "source_type", "source_id",
    "source_freeze_event_seq", "template_version", "generator", "sha256", "body_sha256",
    "provenance", "verification", "resources"
  ],
  "properties": {
    "document_id": {"type": "string", "pattern": "^doc-[0-9a-f]{16}$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["DRAFT_PRE_VERIFICATION", "ATTEMPT_FINALIZED", "FINALIZED"]},
    "doc_type": {"type": "string", "enum": ["task", "brainstorm", "schedule_run", "period"]},
    "source_type": {"type": "string"},
    "source_id": {"type": "string"},
    "source_freeze_event_seq": {"type": "integer", "minimum": 0},
    "template_version": {"type": "string"},
    "generator": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "required": ["task_id", "root_task_id", "channel", "event_ids", "artifact_ids", "verification_ids", "revision_ids", "decision_ids", "schedule_run_id", "sensitive_event_ids"],
      "properties": {
        "task_id": {"type": "string"},
        "root_task_id": {"type": ["string", "null"]},
        "channel": {"type": ["object", "null"]},
        "event_ids": {"type": "array", "items": {"type": "string"}},
        "artifact_ids": {"type": "array", "items": {"type": "string"}},
        "verification_ids": {"type": "array", "items": {"type": "string"}},
        "revision_ids": {"type": "array", "items": {"type": "string"}},
        "decision_ids": {"type": "array", "items": {"type": "string"}},
        "schedule_run_id": {"type": ["string", "null"]},
        "sensitive_event_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": ["object", "null"],
      "required": ["verification_id", "revision", "result"],
      "properties": {
        "verification_id": {"type": "string"},
        "revision": {"type": "integer"},
        "result": {"type": "string", "enum": ["PASSED", "FAILED", "BLOCKED"]},
        "findings": {"type": "integer"},
        "residual_risks": {"type": "integer"}
      }
    },
    "resources": {
      "type": "object",
      "required": ["agents", "models", "tools", "input_tokens", "output_tokens", "tool_calls", "wall_ms", "cost_units", "artifacts", "sources"],
      "description": "Every field has a value or a standard UNAVAILABLE_<REASON> placeholder (V-P6-11)."
    }
  },
  "additionalProperties": false
}
