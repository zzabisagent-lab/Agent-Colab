# Agent-Colab — example environment. Copy to .env locally; never commit .env.
AGENT_COLAB_INSTANCE_NAME=Agent-Colab
AGENT_COLAB_BASE_URL=http://127.0.0.1:8080
AGENT_COLAB_BIND_HOST=127.0.0.1
AGENT_COLAB_BIND_PORT=8080
# AGENT_COLAB_DATABASE_URL=postgresql://colab:***@localhost:5432/colab
# AGENT_COLAB_TEST_DATABASE_URL=postgresql://colab:***@localhost:5432/colab_test
AGENT_COLAB_DEFAULT_TIMEZONE=UTC
AGENT_COLAB_DEFAULT_LANGUAGE=en
